  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "pnpm -r --if-present run test",
    "tsc": "pnpm -r --if-present run tsc",
    "lint": "pnpm -r --if-present run lint",
    "format": "pnpm -r --if-present run format && oxfmt '!packages/**'",
    "format:check": "pnpm -r --if-present run format:check && oxfmt --check '!packages/**'",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.54.1",
    "oxfmt": "^0.73.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
